{
  "name": "DeeDee CMS",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-24-bookworm",
  "postCreateCommand": "npm ci --prefix cms/grapesjs && bash cms/grapesjs/install-autostart.sh",
  "postStartCommand": "setsid nohup bash cms/grapesjs/start-codespace.sh >> /tmp/deedee-cms.log 2>&1 < /dev/null &",
  "forwardPorts": [
    4174
  ],
  "portsAttributes": {
    "4174": {
      "label": "DeeDee CMS",
      "onAutoForward": "openBrowserOnce",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "git.autofetch": false
      }
    }
  },
  "postAttachCommand": "setsid nohup bash cms/grapesjs/start-codespace.sh >> /tmp/deedee-cms.log 2>&1 < /dev/null &"
}
